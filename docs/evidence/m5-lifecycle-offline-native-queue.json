  "diagnostic_source": "\"\"\"Actual native live owner/queue, driven offline by an unchanged real recording.\"\"\"\nimport asyncio\nfrom decimal import Decimal\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport time\n\nfrom src.workstation.analytics import AnalyticsEngine\nfrom src.workstation.recording import RecordingReader\nfrom src.workstation.replay import ReplaySession\nfrom src.workstation.runtime import ClientSession, TerminalRuntime\nfrom src.workstation.visuals import VisualHistory\n\nROOT = Path(__file__).resolve().parents[2]\nCAPTURE = ROOT / 'data/m2-smoke/live-cli-gry1ld8s/captures/9b355ab1-b2a2-4dbb-ae67-a47710272382'\n\nasync def main():\n    observations = []\n    rejected = []\n    with TemporaryDirectory(prefix='m5-native-offline-queue-') as state:\n        runtime = TerminalRuntime(state_dir=Path(state))\n        native = ClientSession(runtime, 'live', 'retained-offline-source')\n        with RecordingReader(CAPTURE) as reader:\n            def initialize():\n                native.streams = reader.manifest.streams\n                native.choose('binance-global:spot-v3:spot:BTCUSDT')\n                native.engine = AnalyticsEngine(native.streams)\n                native.visuals = VisualHistory(native.engine, native.key)\n                native.source_identity = 'offline-queue:' + str(reader.manifest.session_id)\n                native._initialize_consumers()\n                native.status = 'live'\n                native.live_stream_ids = frozenset(spec.stream_id for spec in native.streams)\n                native.live_stream_keys = {spec.stream_id: spec.key for spec in native.streams}\n            await native.work(initialize)\n            class Driver:\n                observer_id = 'native-offline-queue'\n                version = '1'\n                def reset(self):\n                    observations.clear()\n                    rejected.clear()\n                def on_batch(self, batch, books, clock):\n                    if native.status != 'live':\n                        return\n                    prior_bytes = native.live_bytes\n                    native.offer(batch.events, books)\n                    observations.append({'delivery': str(batch.delivery_index), 'wall_mono_ns': str(time.monotonic_ns()),\n                        'source_mono_ns': str(batch.events[0].receive_mono_ns), 'replay_mono_ns': str(clock.reading.mono_ns),\n                        'queue_count': native.live_queue.qsize(), 'queue_bytes': native.live_bytes, 'status': native.status,\n                        'instruments': sorted({str(event.key.instrument_id) for event in batch.events}),\n                        'payload_types': [type(event.payload).__name__ for event in batch.events]})\n                    if native.status == 'unavailable':\n                        changed = [book for book in books if book.key in native.affected_keys(batch.events)]\n                        rejected.append({'delivery': str(batch.delivery_index), 'prior_queued_bytes': prior_bytes,\n                            'atomic_event_bytes': len(repr(batch.events)),\n                            'atomic_book_bytes': sum(4096 + 512 * (len(book.bids) + len(book.asks)) for book in changed),\n                            'books': [{'instrument_id': str(book.instrument_id), 'bids': len(book.bids), 'asks': len(book.asks)} for book in changed],\n                            'error': native.error})\n            replay = ReplaySession(reader, observers=(Driver(),))\n            native.live_task = asyncio.create_task(native.consume_live())\n            started = time.monotonic()\n            try:\n                await replay.run_to_end(speed=Decimal(\"1\"))\n                drain_started = time.monotonic()\n                while native.live_queue.qsize() and time.monotonic() - drain_started < 5:\n                    await asyncio.sleep(.01)\n                result = {'native_status': native.status, 'native_error': native.error,\n                    'native_deliveries_applied': native.delivery, 'telemetry': dict(native.telemetry),\n                    'queue_count_after_drain': native.live_queue.qsize(), 'queue_bytes_after_drain': native.live_bytes,\n                    'elapsed_seconds': time.monotonic() - started, 'drain_seconds': time.monotonic() - drain_started,\n                    'replay_deliveries': replay.cursor.delivery_index, 'replay_book_hash': replay.book_hash}\n            finally:\n                replay.close()\n                await native.close()\n                await runtime.close()\n    result.update(scope='OFFLINE real retained capture at native ReplaySession speed1 into actual ClientSession.offer/consume_live and owner executor. Original normalized events, source ordering, native depths and256-delivery/8MiB bounds unchanged. No network. Incomplete owner history after fail-closed overflow is explicitly not a successful live acceptance.',\n        capture=str(CAPTURE), manifest_sha256=hashlib.sha256((CAPTURE / 'manifest.json').read_bytes()).hexdigest(),\n        diagnostic_source=Path(__file__).read_text(), native_sources={str(p.relative_to(ROOT)): {'sha256': hashlib.sha256(p.read_bytes()).hexdigest(), 'source': p.read_text()} for p in sorted((ROOT / 'src/workstation').rglob('*.py'))},\n        observations=observations, rejected_atomic_deliveries=rejected,\n        cleanup={'session_closed': native.closed, 'runtime_closed': runtime.closed, 'consumer_done': native.live_task.done()})\n    output = ROOT / 'docs/evidence/m5-lifecycle-offline-native-queue.json'\n    output.write_text(json.dumps(result, indent=2) + '\\n')\n    print(json.dumps({k: v for k, v in result.items() if k not in ('native_sources', 'diagnostic_source', 'observations')}, indent=2))\n    print('Evidence:', output)\n\nasyncio.run(main())\n",
