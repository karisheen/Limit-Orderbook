    "data/m2-profile-writer/profile_isolated.py": "\"\"\"Offline actual writer service profile; source losses remain explicitly incomplete.\n\nThe worker offers the next preserved immutable item after writing the current one.\nThe producer is parked, avoiding CPython 3.13 cProfile cross-thread contamination.\nThis profiles actual Recorder._run dispatch, compression, projection, SQLite and\nsealing with unchanged limits, not a live-capture or real-time-throughput claim.\n\"\"\"\nimport cProfile\nfrom dataclasses import asdict\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport pstats\nimport sys\nimport time\nfrom src.workstation import wire\nfrom src.workstation.recording import Recorder, RecordingReader\n\nSOURCE = Path('data/m2-smoke/live-cli-3hjtn5tf/captures/9ec8ec8a-5cd8-4fe3-807c-33b5549f746a')\noutput = Path('data/m2-profile-writer') / sys.argv[1]\noutput.mkdir()\nsource_code = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in (\n    Path('src/workstation/recording.py'), Path('src/workstation/wire.py'),\n    Path('src/workstation/book.py'), Path('src/workstation/projection.py'),\n    Path('src/workstation/adapters/binance.py'), Path('src/workstation/precision.py'),\n)}\nwith RecordingReader(SOURCE, allow_incomplete=True) as reader:\n    original = reader.manifest\n    raw = list(reader.iter_raw())\n    batches = list(reader.iter_batches())\n    original_checkpoints = list(reader.iter_checkpoints())\nraw_by_key = {(frame.stream_id, frame.ingest_ordinal): frame for frame in raw}\noffered = set()\nworkload = []\nfor batch in batches:\n    event = batch.events[0]\n    key = (event.stream_id, event.ingest_ordinal)\n    if key in raw_by_key and key not in offered:\n        workload.append(('raw', raw_by_key[key]))\n        offered.add(key)\n    workload.append(('events', batch.events))\nworkload.extend(('raw', frame) for frame in raw if (frame.stream_id, frame.ingest_ordinal) not in offered)\n\nclass ProfiledRecorder(Recorder):\n    def _advance(self):\n        item = next(self._source_items, None)\n        if item is None:\n            for reason in original.incomplete_reasons:\n                self.mark_incomplete(reason)\n            with self._condition:\n                self._closing = True\n        elif item[0] == 'raw':\n            self.append_raw(item[1])\n        else:\n            self.append_events(item[1])\n\n    def _write_raw(self, frame):\n        super()._write_raw(frame)\n        self._advance()\n\n    def _write_events(self, batch):\n        super()._write_events(batch)\n        self._advance()\n\n    def _run(self):\n        self._source_items = iter(workload)\n        self.mark_incomplete('profile_of_incomplete_source')\n        self._advance()\n        profiler = cProfile.Profile()\n        started = time.perf_counter()\n        profiler.runcall(super()._run)\n        self.profile_elapsed = time.perf_counter() - started\n        profiler.dump_stats(str(output / 'writer.prof'))\n        report = io.StringIO()\n        pstats.Stats(profiler, stream=report).strip_dirs().sort_stats('cumulative').print_stats(80)\n        (output / 'writer.txt').write_text(report.getvalue())\n\nrecorder = ProfiledRecorder(\n    output / 'captures', session_id=original.session_id, clock_id=original.clock_id,\n    streams=original.streams, config=original.config, limits=original.limits,\n    provenance='Offline writer profile of incomplete original capture; not live or complete history',\n    code_revision=original.code_revision, license=original.license,\n)\nrecorder._thread.join()\nmanifest = recorder._manifest\n\ndef digest(values):\n    state = hashlib.sha256()\n    for value in values:\n        payload = wire.dumps(value, canonical=False)\n        state.update(len(payload).to_bytes(8, 'big'))\n        state.update(payload)\n    return state.hexdigest()\n\ndef checkpoint_hash(checkpoints):\n    return digest((cp.delivery_index, cp.checkpoint, cp.observer_state) for cp in checkpoints)\n\nwith RecordingReader(recorder.path, allow_incomplete=True) as reader:\n    hashes = {\n        'raw': digest(sorted(reader.iter_raw(), key=lambda frame: (str(frame.stream_id), frame.ingest_ordinal))),\n        'events': digest(batch.events for batch in reader.iter_batches()),\n        'checkpoints': checkpoint_hash(reader.iter_checkpoints()),\n    }\nsummary = {\n    'source': str(SOURCE),\n    'source_manifest_sha256': hashlib.sha256((SOURCE / 'manifest.json').read_bytes()).hexdigest(),\n    'source_code_sha256': source_code,\n    'source_complete': original.complete,\n    'source_reasons': original.incomplete_reasons,\n    'source_file_hashes': {record.path: record.sha256 for record in original.files},\n    'limits': asdict(original.limits), 'config': original.config,\n    'source_raw_hash': digest(sorted(raw, key=lambda frame: (str(frame.stream_id), frame.ingest_ordinal))),\n    'source_events_hash': digest(batch.events for batch in batches),\n    'source_checkpoints_hash': checkpoint_hash(original_checkpoints),\n    'writer_elapsed_seconds': recorder.profile_elapsed,\n    'output_counts': {'raw': manifest.raw_count, 'events': manifest.event_count,\n                      'batches': manifest.batch_count, 'checkpoints': manifest.checkpoint_count},\n    'output_complete': manifest.complete, 'output_reasons': manifest.incomplete_reasons,\n    'output_hashes': hashes, 'health': asdict(recorder.health),\n    'command': f'PYTHONPATH=. .venv-upgrade/bin/python data/m2-profile-writer/profile_isolated.py {sys.argv[1]}',\n    'caveat': 'Writer-thread cProfile includes offline offer accounting but no producer polling; concurrent timings are hotspot evidence, not live latency.',\n}\n(output / 'summary.json').write_text(json.dumps(summary, indent=2) + '\\n')\nprint(json.dumps({key: value for key, value in summary.items() if key not in ('source_file_hashes', 'limits', 'source_reasons', 'output_reasons', 'health')}, indent=2))\n"
