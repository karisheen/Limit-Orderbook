{
  "harness_source": "\"\"\"Throwaway real-thread component timing; no source/queue/depth changes.\"\"\"\nimport gc\nimport json\nimport sys\nimport threading\nimport time\nfrom collections import defaultdict, deque\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\nfrom src.workstation import runtime\nfrom src.workstation.analytics import AnalyticsEngine\nfrom src.workstation.visuals import VisualHistory\nfrom src.workstation.context import ContextEngine\nfrom src.workstation.alerts import AlertEngine\nfrom src.workstation.paper import PaperEngine\nfrom src.workstation.cli import main\n\noriginal = runtime.ClientSession._owned_call\noriginal_enqueue = runtime.ClientSession._enqueue_live\ncontext = threading.local()\nrows = defaultdict(lambda: deque(maxlen=512))\ncounts = defaultdict(int)\nmaxima = defaultdict(float)\noverflows = []\n\n\ndef gc_observation(phase, info):\n    if phase == \"start\":\n        context.gc_start = (time.perf_counter(), time.thread_time())\n        return\n    started = getattr(context, \"gc_start\", None)\n    if started is None:\n        return\n    owner = getattr(context, \"key\", None)\n    key = ((owner[0], owner[1], owner[2] + \"/\") if owner else (threading.current_thread().name, None, \"\"))\n    key = (*key[:2], key[2] + \"gc_generation_\" + str(info[\"generation\"]))\n    wall = (time.perf_counter() - started[0]) * 1000\n    cpu = (time.thread_time() - started[1]) * 1000\n    counts[key] += 1\n    maxima[key] = max(maxima[key], wall)\n    rows[key].append({\"wall_ms\": wall, \"thread_cpu_ms\": cpu})\n\n\ndef measure(key, fn, /, *args, **kwargs):\n    wall, cpu = time.perf_counter(), time.thread_time()\n    try:\n        return fn(*args, **kwargs)\n    finally:\n        elapsed = (time.perf_counter() - wall) * 1000\n        elapsed_cpu = (time.thread_time() - cpu) * 1000\n        counts[key] += 1\n        maxima[key] = max(maxima[key], elapsed)\n        rows[key].append({\"wall_ms\": elapsed, \"thread_cpu_ms\": elapsed_cpu})\n\n\ndef measured(self, fn, closing):\n    prior = getattr(context, \"key\", None)\n    key = (self.id, self.instrument_id, getattr(getattr(fn, \"func\", fn), \"__name__\", \"unknown\"))\n    context.key = key\n    try:\n        return measure(key, original, self, fn, closing)\n    finally:\n        context.key = prior\n\n\ndef stage(fn):\n    def measured_stage(*args, **kwargs):\n        key = getattr(context, \"key\", None)\n        if key is None:\n            return fn(*args, **kwargs)\n        return measure((*key[:2], key[2] + \"/\" + fn.__qualname__), fn, *args, **kwargs)\n    return measured_stage\n\n\ndef enqueue(self, selected, books):\n    prior = self.telemetry[\"overflows\"]\n    original_enqueue(self, selected, books)\n    if self.telemetry[\"overflows\"] != prior:\n        queued_bytes = sum(item[3] for item in self.live_queue._queue)\n        overflows.append({\n            \"session\": self.id, \"instrument\": self.instrument_id,\n            \"owned_bytes\": self.live_bytes, \"queued_bytes\": queued_bytes,\n            \"inflight_bytes\": self.live_bytes - queued_bytes,\n            \"queued_count\": self.live_queue.qsize(), \"inflight_count\": self.live_inflight,\n            \"selected_stream_count\": len(self.streams),\n            \"selected_books\": [str(s.key) for s in self.streams if s.key.channel == \"book\"],\n            \"rejected_event_keys\": [str(e.key) for e in selected],\n            \"rejected_books\": [{\"key\": str(b.key), \"revision\": b.revision, \"levels\": len(b.bids)+len(b.asks)} for b in books if b.key in self.affected_keys(selected)],\n        })\n\n\nruntime.ClientSession._owned_call = measured\nruntime.ClientSession._enqueue_live = enqueue\nruntime._analytics_presentation = stage(runtime._analytics_presentation)\nruntime._book_presentation = stage(runtime._book_presentation)\nAnalyticsEngine.snapshot = stage(AnalyticsEngine.snapshot)\nAnalyticsEngine.on_batch = stage(AnalyticsEngine.on_batch)\nfor observer in (VisualHistory, ContextEngine, AlertEngine, PaperEngine):\n    observer.on_batch = stage(observer.on_batch)\ngc.callbacks.append(gc_observation)\ntry:\n    main()\nfinally:\n    gc.callbacks.remove(gc_observation)\n    report = {\n        \"harness_source\": Path(__file__).read_text(),\n        \"limitations\": \"Real-thread elapsed/CPU component observations with nested timer overhead; last512 rows per component and all-call maxima. No cProfile, throughput certification, queue/depth/cohort changes or substituted market data.\",\n        \"overflows\": overflows,\n        \"operations\": [\n            {\"session\": key[0], \"instrument\": key[1], \"operation\": key[2], \"calls\": counts[key],\n             \"max_wall_ms\": maxima[key], \"last_measurements\": list(values)}\n            for key, values in rows.items()\n        ],\n    }\n    Path(\"docs/evidence/live-visuals-component-timing-after.json\").write_text(\n        json.dumps(report, indent=2) + \"\\n\"\n    )\n",
  "limitations": "Real-thread elapsed/CPU component observations with nested timer overhead; last512 rows per component and all-call maxima. No cProfile, throughput certification, queue/depth/cohort changes or substituted market data. Quantiles summarize the retained last512 samples only; maximum wall time covers all calls.",
