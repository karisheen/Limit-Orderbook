  "script": "\"\"\"Native full-depth observer service/parity measurement; synthetic activity.\"\"\"\nimport cProfile\nimport hashlib\nimport json\nfrom pathlib import Path\nimport runpy\nimport sys\nimport time\nfrom src.workstation.wire import dumps\nfrom src.workstation.precision import DERIVED_DECIMAL_POLICY\nfrom decimal import Decimal\n\nFeed = runpy.run_path('tests/test_workstation_analytics.py')['Feed']\nfeed = Feed()\nbids = tuple((str(Decimal('100000')-Decimal(i)/100), '1') for i in range(5000))\nasks = tuple((str(Decimal('100000.01')+Decimal(i)/100), '1') for i in range(5000))\nfeed.quote(1, bids=bids, asks=asks)\nfeed.quote(4, bids=((bids[0][0], '2'), *bids[1:]), asks=asks)\ndef exercise():\n    return [feed.snapshot(4+i) for i in range(100)]\nstart, cpu = time.perf_counter(), time.process_time()\nresults = exercise()\nwall, cpu = time.perf_counter()-start, time.process_time()-cpu\npayload = dumps(tuple(results), canonical=True, decimal_policy=DERIVED_DECIMAL_POLICY)\nprofile = cProfile.Profile()\nprofile.runcall(exercise)\nrows = [{'code': str(r.code) if isinstance(r.code,str) else f'{r.code.co_filename}:{r.code.co_firstlineno}:{r.code.co_name}', 'calls':r.callcount, 'total_seconds':r.totaltime, 'inline_seconds':r.inlinetime} for r in sorted(profile.getstats(),key=lambda r:-r.totaltime)[:40]]\nresult = {'scope':'Single-thread native analytics; original synthetic5000 bid/5000 ask levels;100 distinct clock frontiers. Unprofiled timing, then separate profile. No source events skipped.', 'wall_seconds':wall,'cpu_seconds':cpu,'snapshot_sha256':hashlib.sha256(payload).hexdigest(),'state_sha256':feed.engine.state_hash,'source_sha256':hashlib.sha256(Path('src/workstation/analytics.py').read_bytes()).hexdigest(),'script':Path(__file__).read_text(),'profile':rows}\npath=Path('docs/evidence/m5-depth-service-'+sys.argv[1]+'.json')\npath.write_text(json.dumps(result,indent=2)+'\\n')\nprint(json.dumps({k:v for k,v in result.items() if k not in ('script','profile')},indent=2))\nprint(path)\n",
